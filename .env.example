# Create a Supabase project, then copy its Project URL and publishable (anon) key here.
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_SUPABASE_PUBLISHABLE_KEY
VITE_APP_URL=http://localhost:5173

# Server-only ZeptoMail values. Set these with `supabase secrets set` for the Edge Function.
ZEPTOMAIL_SMTP_HOST=smtp.zeptomail.in
ZEPTOMAIL_SMTP_PORT=587
ZEPTOMAIL_SMTP_USER=emailapikey
ZEPTOMAIL_SMTP_PASSWORD=YOUR_ZEPTOMAIL_SMTP_PASSWORD
ZEPTOMAIL_FROM_EMAIL=care@example.com
ZEPTOMAIL_FROM_NAME=RicozDesk